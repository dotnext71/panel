[Unit]
Description=dotnexthosted.com free-hostname service (JAB-213)
After=network-online.target pdns.service
Wants=network-online.target

[Service]
Type=simple
User=dotnexthosted
Group=dotnexthosted
EnvironmentFile=/etc/dotnexthosted/svc.env
ExecStart=/usr/local/bin/dotnexthosted-svc serve
Restart=on-failure
RestartSec=5s

# Hardening — same posture as the dotnext units: never loosened for features.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/dotnexthosted
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
