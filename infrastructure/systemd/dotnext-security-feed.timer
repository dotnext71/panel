[Unit]
Description=Hourly dotNext security advisory feed check
Documentation=https://github.com/dotnext71/panel/blob/main/docs/runbooks/security-advisory.md

[Timer]
# Hourly, spread over 15 minutes so every server does not fetch the feed in
# the same second.
OnCalendar=hourly
RandomizedDelaySec=15min
Persistent=true
Unit=dotnext-security-feed.service

[Install]
WantedBy=timers.target
