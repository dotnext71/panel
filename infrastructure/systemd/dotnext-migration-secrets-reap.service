[Unit]
Description=Wipe migration-secrets env files for terminal-state migration_jobs (M35 ADR-0094)
Documentation=https://github.com/dotnext71/panel/blob/main/docs/adr/0094-migration-importers.md
After=dotnext-api.service mariadb.service
# No Requires= — daily cadence + Persistent=true means a missed run on
# a transiently-unhealthy panel just slides to the next tick; same
# resilience pattern as dotnext-sso-reaper.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dotnext-cli migrate reap-secrets
StandardOutput=journal
StandardError=journal
Restart=no

# Hardening: reaper only needs read on migration_jobs (already wired
# through the panel DB cred) + unlink on /etc/dotnext/migration-
# secrets/*.env + removal of stale per-job staging trees under
# /var/lib/dotnext-migrations/<id>/ (row-driven and JAB-155 orphan
# sweep). ProtectSystem + ReadWritePaths confines the surface; a path
# missing here makes every removal there fail with "read-only file
# system".
ProtectSystem=strict
ReadWritePaths=/etc/dotnext/migration-secrets /var/lib/dotnext-migrations
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
