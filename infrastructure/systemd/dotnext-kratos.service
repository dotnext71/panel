[Unit]
Description=Ory Kratos Identity Provider
Documentation=https://www.ory.sh/docs/kratos
After=network-online.target mariadb.service
Wants=network-online.target
PartOf=dotnext.slice

[Service]
Type=simple
User=dotnext
# M25 Step 2: Group is dotnext-sockets so the admin socket created at
# /run/dotnext-kratos/admin.sock lands in a group panel-api (also a member
# of dotnext-sockets) can connect to. The dotnext user remains the owner;
# the group switch is purely about who else can reach the socket.
Group=dotnext-sockets
# When Group= is set explicitly alongside User=, systemd replaces the
# process's primary GID with the value here AND does NOT inherit the
# user's /etc/passwd primary group as a supplementary (because being
# the user's primary group does not list the user in /etc/group's
# member list). Without this line, Kratos runs as dotnext:dotnext-sockets
# with no `dotnext` supplementary — and can't read
# /etc/dotnext/kratos.yml (root:dotnext 0640), dying at startup
# with "permission denied". Mirror pattern already used by
# dotnext-stalwart.service for the same reason.
SupplementaryGroups=dotnext mysql
Slice=dotnext.slice

# RuntimeDirectory creates /run/dotnext-kratos/ as dotnext:dotnext-sockets 0750
# before ExecStart, with RuntimeDirectoryPreserve=no so the directory is
# torn down on stop. Kratos creates the admin.sock file inside on listen()
# — but the FILE's mode + group are set by Kratos itself via socket.{mode,
# group} in /etc/dotnext/kratos.yml, NOT by RuntimeDirectory (which
# only governs the parent dir). Both are pinned for defense in depth.
RuntimeDirectory=dotnext-kratos
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no

ExecStart=/usr/local/bin/kratos serve -c /etc/dotnext/kratos.yml

# ExecStartPost belt-and-braces (M25 review F-C-3, see infrastructure/scripts/
# socket-helpers.sh top comment). Kratos's own socket.{mode,group} config
# is the primary mechanism, but if Kratos is ever upgraded to a version
# that drops or renames those fields, the post-start chmod + chgrp keep
# panel-api → Kratos working until the operator notices the verify_socket_perms
# check shouting in install.sh output. Idempotent: chmod/chgrp on the
# already-correct values is a no-op.
ExecStartPost=/bin/sh -c 'until [ -S /run/dotnext-kratos/admin.sock ] && [ -S /run/dotnext-kratos/public.sock ]; do sleep 0.1; done'
ExecStartPost=/bin/chgrp dotnext-sockets /run/dotnext-kratos/admin.sock
ExecStartPost=/bin/chmod 0660 /run/dotnext-kratos/admin.sock
ExecStartPost=/bin/chgrp dotnext-sockets /run/dotnext-kratos/public.sock
ExecStartPost=/bin/chmod 0660 /run/dotnext-kratos/public.sock

Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# JAB-2: /etc/dotnext is READ-ONLY for Kratos. It only reads kratos.yml +
# the identity schema from there; sockets live under RuntimeDirectory
# /run/dotnext-kratos. Dropping config write access stops a Kratos RCE/dep
# compromise from rewriting panel config/secrets (persistent panel compromise)
# and keeps AIDE/AppArmor's "config is immutable" expectation honest.
ReadWritePaths=/run/dotnext-kratos /run/mysqld

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
