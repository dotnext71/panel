[Unit]
Description=Run dotnext-migration-secrets-reap.service daily at 04:30
Documentation=https://github.com/dotnext71/panel/blob/main/docs/adr/0094-migration-importers.md

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=15min
Persistent=true
Unit=dotnext-migration-secrets-reap.service

[Install]
WantedBy=timers.target
