# dotNext Panel — example environment.
#
# These ENV vars override values from config.toml. Typical use: put non-secret
# config in /etc/dotnext/config.toml, put secrets here (or in a secrets manager)
# and load via systemd's EnvironmentFile.
#
# Copy to .env for local dev, or to /etc/dotnext/panel.env for the systemd unit.
# NEVER commit a real secrets file — .env is git-ignored.
#
# Full reference with defaults + precedence: docs/ENV.md

# Server
PANEL_ADDR=127.0.0.1:8443
PANEL_ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Database
# DATABASE_URL=mysql://dotnext_panel:CHANGE_ME@tcp(127.0.0.1:3306)/dotnext_panel?parseTime=true&charset=utf8mb4&loc=UTC

# Auth
# AUTH_PROVIDER=kratos
# JWT_SECRET=$(openssl rand -hex 32)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h

# Kratos (identity provider)
# KRATOS_PUBLIC_URL=unix:/run/dotnext-kratos/public.sock
# KRATOS_ADMIN_URL=unix:/run/dotnext-kratos/admin.sock

# Agent client (dotnext-api -> /run/dotnext/agent.sock)
# AGENT_SOCKET=/run/dotnext/agent.sock
# AGENT_TIMEOUT=5s

# Agent daemon (read by dotnext-agent)
# DOTNEXT_AGENT_SOCKET=/run/dotnext/agent.sock
# DOTNEXT_AGENT_GID=-1
# DOTNEXT_AGENT_LOG_FORMAT=json
# DOTNEXT_AGENT_LOG_LEVEL=info

# CORS
# CORS_ALLOWED_ORIGINS=https://panel.example.com,http://localhost:5173

# SSL / ACME
# DOTNEXT_ACME_STAGING_ONLY=false

# SSO
# DOTNEXT_SSO_KEY_PATH=/etc/dotnext/sso.key

# Install-time knobs (install.sh only)
# DOTNEXT_PHP_VERSIONS="8.2 8.3 8.4"
# DOTNEXT_GITHUB_TOKEN=

# Where dotnext looks for the TOML file (default /etc/dotnext/config.toml)
# DOTNEXT_CONFIG=/etc/dotnext/config.toml
